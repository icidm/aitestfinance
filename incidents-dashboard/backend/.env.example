DATABASE_URL=sqlite+aiosqlite:///./app.db
DATABASE_URL_SYNC=sqlite:///./app.db
# For postgres:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/incidents
# DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/incidents
SECRET_KEY=change-me-please-32-chars-minimum-secret-key!
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=http://localhost:8000,http://localhost:3000
MAX_OFFSET=10000
LOG_LEVEL=INFO
